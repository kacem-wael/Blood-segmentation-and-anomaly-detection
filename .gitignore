# Repository for the course submission: code, configuration, the data we produced,
# the pipeline outputs and the results. Documentation is delivered separately.

# ---- Documentation, report, presentation, notebooks, trained model (not versioned)
docs/
notebooks/
models/
project.md
*.docx
*.pdf
~$*

# ---- Data
# Raw images are too large for Git (~700 MB): `python scripts/download_data.py` (or `make data`).
# Versioned: data/splits.json, data/index/, data/features/, data/masks_manual/
data/raw/
data/downloads/

# ---- Environments and caches
.venv/
.venv-labelme/
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.ipynb_checkpoints/

# ---- Generated on demand
# Live demo output (scripts/demo.py, regenerated by `make demo`)
demo/
# Raw run logs (warnings, progress)
results/tables/log_*.txt

# ---- Secrets
kaggle.json
