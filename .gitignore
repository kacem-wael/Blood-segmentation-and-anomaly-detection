# Data: never committed (see scripts/download_data.py)
data/*
# ...except what both annotators need: the split definition and the manual masks (+ drafts)
!data/splits.json
!data/masks_manual/

# Environments and caches
.venv/
.venv-labelme/
.venv-labelme/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Per-step pipeline images (scripts/export_steps.py, regenerated with `make outputs`)
outputs/

# Generated results (figures/tables worth keeping are added explicitly)
results/**/*.png
results/**/*.csv

# Office lock files
~$*

# Secrets
kaggle.json

# Report figures and summary tables that are versioned on purpose
!results/figures/pipeline/*.png
!results/figures/classification/*.png
!results/figures/evaluation/*.png
!results/tables/eval_val_summary.csv
!results/tables/eval_val_ablation.csv
